# Copy this file to .env and replace placeholder values with your own.
# cp .env.example .env   (or on Windows: copy .env.example .env)

# OpenRouter (required when using `python main.py query ... --call`)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_LLM_MODEL=openai/gpt-4o-mini

# Router / embeddings (optional; defaults shown)
EMBEDDING_MODEL=all-MiniLM-L6-v2
ROUTING_THRESHOLD=0.25
